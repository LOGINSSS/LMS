{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/LOGINSSS/LMS/main/docs/api-schemas/ai.schema.json",
  "title": "AI 对话契约（lms-ai）",
  "description": "AI 对话接口的请求与响应结构。对应 lms-ai ChatController 的 ChatRequest，响应为 R 包装的字符串。",
  "$defs": {
    "ChatRequest": {
      "type": "object",
      "description": "LLM 单轮对话入参",
      "required": ["prompt"],
      "properties": {
        "prompt": { "type": "string", "minLength": 1, "description": "用户提问内容" }
      },
      "additionalProperties": false
    },
    "ChatResponse": {
      "type": "string",
      "description": "R.data 负载：LLM 回复文本（流式按对话轮次返回完整文本）"
    }
  }
}
