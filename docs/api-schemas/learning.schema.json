{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/LOGINSSS/LMS/main/docs/api-schemas/learning.schema.json",
  "title": "学习过程契约（lms-learning）",
  "description": "学习模块的积分/签到相关响应结构。对应 lms-learning 的 PointsVO / PointsBoardVO。",
  "$defs": {
    "PointsVO": {
      "type": "object",
      "description": "积分明细条目（GET /points/records 分页负载元素）",
      "properties": {
        "id": { "type": "integer" },
        "type": { "type": "integer", "description": "积分类型：1 签到 / 2 学习 / 3 提问 / 4 回答采纳 / 5 点赞" },
        "points": { "type": "integer", "description": "积分变动（正增负减）" },
        "createTime": { "type": ["string", "null"], "format": "date-time" }
      },
      "additionalProperties": false
    },
    "PointsBoardVO": {
      "type": "object",
      "description": "积分榜条目（GET /points/board，用户名由前端按 userId 补全）",
      "properties": {
        "userId": { "type": "integer" },
        "totalPoints": { "type": "integer", "description": "积分总分" }
      },
      "additionalProperties": false
    }
  }
}
