{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/LOGINSSS/LMS/main/docs/api-schemas/course.schema.json",
  "title": "课程契约（lms-course）",
  "description": "课程模块的卡片出参与建课/改课入参。对应 lms-course 的 CourseCardVO / CourseFormDTO。列表/详情/我的课程/我选过的课程共用 CourseCardVO。",
  "$defs": {
    "CourseCardVO": {
      "type": "object",
      "description": "课程卡片（前端卡片展示专用 JSON）",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "integer" },
        "name": { "type": "string", "maxLength": 100, "description": "课程名称" },
        "cover": { "type": ["string", "null"], "description": "封面图 URL" },
        "intro": { "type": ["string", "null"], "description": "课程简介" },
        "category": { "type": ["string", "null"], "description": "课程分类" },
        "teacherId": { "type": ["integer", "null"], "description": "归属教师 id" },
        "teacherName": { "type": ["string", "null"], "description": "教师昵称（卡片署名）" },
        "status": { "type": ["integer", "null"], "enum": [0, 1], "description": "0 已下架 / 1 已发布" },
        "totalCount": { "type": ["integer", "null"], "description": "选课人数" },
        "createTime": { "type": ["string", "null"], "format": "date-time" }
      },
      "additionalProperties": false
    },
    "CourseFormDTO": {
      "type": "object",
      "description": "建课（POST /admin/courses）/ 改课（PUT /admin/courses/{id}）入参；修改场景未传字段不更新",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "cover": { "type": ["string", "null"], "maxLength": 255 },
        "intro": { "type": ["string", "null"], "maxLength": 500 },
        "category": { "type": ["string", "null"], "maxLength": 50 }
      },
      "additionalProperties": false
    }
  }
}
