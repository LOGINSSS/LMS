{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/LOGINSSS/LMS/main/docs/api-schemas/auth.schema.json",
  "title": "认证契约（lms-auth）",
  "description": "注册/登录/登出接口的请求与响应结构。对应 lms-auth 的 LoginFormDTO / RegisterFormDTO / LoginVO。",
  "$defs": {
    "LoginFormDTO": {
      "type": "object",
      "required": ["username", "password"],
      "properties": {
        "username": { "type": "string", "minLength": 3, "maxLength": 50 },
        "password": { "type": "string", "minLength": 6, "maxLength": 32 }
      },
      "additionalProperties": false
    },
    "RegisterFormDTO": {
      "type": "object",
      "required": ["username", "password", "userType"],
      "properties": {
        "username": { "type": "string", "minLength": 3, "maxLength": 50 },
        "password": { "type": "string", "minLength": 6, "maxLength": 32 },
        "userType": { "type": "integer", "enum": [1, 2], "description": "1 学生 / 2 教师" },
        "nickname": { "type": ["string", "null"] },
        "phone": { "type": ["string", "null"] },
        "email": { "type": ["string", "null"] },
        "college": { "type": ["string", "null"], "description": "院系（教师扩展）" },
        "title": { "type": ["string", "null"], "description": "职称（教师扩展）" },
        "bio": { "type": ["string", "null"], "description": "个人简介（教师扩展）" },
        "studentNo": { "type": ["string", "null"], "description": "学号（学生扩展）" },
        "major": { "type": ["string", "null"], "description": "专业（学生扩展）" },
        "grade": { "type": ["string", "null"], "description": "年级（学生扩展）" },
        "className": { "type": ["string", "null"], "description": "班级（学生扩展）" }
      },
      "additionalProperties": false
    },
    "LoginVO": {
      "type": "object",
      "required": ["token", "userId", "userType", "username"],
      "properties": {
        "token": { "type": "string", "description": "JWT，后续请求头 Authorization: Bearer <token>" },
        "userId": { "type": "integer", "description": "用户档案 id" },
        "userType": { "type": "integer", "enum": [1, 2] },
        "username": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
