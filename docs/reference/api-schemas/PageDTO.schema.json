{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/LOGINSSS/LMS/main/docs/api-schemas/PageDTO.schema.json",
  "title": "分页响应 PageDTO",
  "description": "分页接口 data 负载结构（lms-common 的 PageDTO）。前端统一用 Pagination 组件对接 total/list。",
  "type": "object",
  "required": ["total", "list"],
  "properties": {
    "total": {
      "type": "integer",
      "description": "总条数"
    },
    "list": {
      "type": "array",
      "description": "当前页数据（元素结构随接口而定）",
      "items": {}
    }
  },
  "additionalProperties": false
}
